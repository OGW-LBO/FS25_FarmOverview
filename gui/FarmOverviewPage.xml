<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    Betriebsuebersicht als eigene Seite im ESC-Menue (ersetzt das fruehere
    Strg+F7-Fenster). Geladen als Frame (g_gui:loadGui(..., true)) und per
    g_inGameMenu:addPage eingehaengt (TabbedMenu.lua:780).

    Aufbau wie die Einstellungsseite des Spiels (Masse aus sdk/xmlDoku/guiProfiles.xml):
      fs25_menuContainer                1550px breit, Hoehe = Bildschirm - 250px
      fs25_menuHeaderPanel              Kopfzeile mit Symbol und Titel (ueber dem Container)
      fs25_subCategorySelectorTabbedBox Bereichs-Reiter oben (57px)
      fs25_subCategorySelectorTabbedContainer  Inhalt darunter (Hoehe - 80px)

    Der Inhalt ist 1:1 der des frueheren Fensters: eine SmoothList mit sechs
    Spalten fuer die Bereiche 1-6 und ein ScrollingLayout mit nativen
    Auswahlfeldern fuer die Einstellungen. Die IDs sind unveraendert, deshalb
    laeuft die bestehende Logik aus FruchtfolgeAdvisorDialog.lua weiter.
-->
<GUI name="FarmOverviewPage">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="faMenuHeaderIcon" id="faHeaderIcon" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="dialogTitleElement" text="$l10n_fa_title" />
        </GuiElement>

        <!-- Bereichs-Reiter -->
        <BoxLayout profile="fs25_subCategorySelectorTabbedBox" id="faTabBox">
            <!-- Reihenfolge: Aufgaben zuerst (Startseite), dann die Inhalte,
                 hinten die Einstellungen (inkl. Fruechte-Auswahl).
                 Die IDs (btnTabN) sind die Bereichs-Indizes, nicht die Position. -->
            <Button profile="fs25_subCategorySelectorTabbedTab" text="$l10n_fa_tab_tasks" onClick="onClickTabReport" id="btnTab5">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" text="$l10n_fa_tab_fields" onClick="onClickTabFelder" id="btnTab1">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" text="$l10n_fa_tab_animals" onClick="onClickTabTiere" id="btnTab3">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" text="$l10n_fa_tab_production" onClick="onClickTabProduktion" id="btnTab4">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" text="$l10n_fa_tab_storage" onClick="onClickTabLager" id="btnTab2">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" text="$l10n_fa_tab_finance" onClick="onClickTabFinanzen" id="btnTab8">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" text="$l10n_fa_tab_settings" onClick="onClickTabSettings" id="btnTab7">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
            </Button>
        </BoxLayout>

        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="faContent">
            <!-- Infozeile: Knappheiten (Felder), Zaehler + Bedienhinweis (Aufgaben),
                 Bedienhinweis (Fruechte). setTab() blendet sie je Bereich ein. -->
            <Text profile="faDShortage" id="faShortage" position="15px -12px" size="1490px 24px" visible="false" />

            <!-- Liste und Scrollbalken in einem gemeinsamen Rahmen (Muster
                 FS25_CropRotation): fs25_listSliderBox haengt sich mit
                 anchorStretchingYRight an den rechten Rand dieses Rahmens
                 (21px daneben) und ist so hoch wie er. Ein with-Attribut am
                 Element wertet das Spiel NICHT aus - daran lag der fehlende
                 Balken (er stand ausserhalb des Bildschirms). -->
            <GuiElement profile="faListFrame" position="15px -44px" size="1490px 680px">
                <SmoothList profile="faDlgList" id="faList" position="0px 0px" size="1490px 680px" onClick="onListClick" onDoubleClick="onListDoubleClick">
                    <ListItem profile="faDlgRow" name="rowTemplate">
                        <Text profile="faDColS" name="colS" />
                        <Text profile="faDColA" name="colA" />
                        <Text profile="faDColB" name="colB" />
                        <Text profile="faDColC" name="colC" />
                        <Text profile="faDColD" name="colD" />
                        <Text profile="faDColE" name="colE" />
                        <Text profile="faDColF" name="colF" />
                    </ListItem>
                </SmoothList>

                <ThreePartBitmap profile="fs25_listSliderBox" id="faListSliderBox">
                    <Slider profile="fs25_listSlider" dataElementId="faList" id="faListSlider" />
                </ThreePartBitmap>
            </GuiElement>

            <!-- Einstellungen: native Auswahlfelder, standardmaessig unsichtbar -->
            <GuiElement profile="faListFrame" position="15px -20px" size="1490px 700px">
            <ScrollingLayout profile="fs25_settingsLayout" id="faSettingsLayout" visible="false">

                <Bitmap profile="faSetRow" id="rowNurHofPC" visible="false">
                    <BinaryOption profile="fs25_settingsBinaryOption" onClick="onClickCheckbox" id="chkNurHofPC" />
                    <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_fa_set_nurhofpc" />
                </Bitmap>

                <Bitmap profile="faSetRow">
