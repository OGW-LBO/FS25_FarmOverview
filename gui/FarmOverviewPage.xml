                    <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_fa_set_affectyield" />
                </Bitmap>

                <!-- Welche Feldarbeiten im Bereich Aufgaben auftauchen. Nicht jeder
                     walzt oder kalkt; AUS laesst die Aufgabe komplett weg. -->
